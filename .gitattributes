# Git LFS for portable Node runtimes (large binaries)
node/linux/bin/node filter=lfs diff=lfs merge=lfs -text
node/win/node32.exe filter=lfs diff=lfs merge=lfs -text
node/win/node64.exe filter=lfs diff=lfs merge=lfs -text

# Normalize line endings for text files
* text=auto
*.sh text eol=lf
*.bat text eol=crlf